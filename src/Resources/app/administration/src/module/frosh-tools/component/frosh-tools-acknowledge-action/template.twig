<div class="ft-acknowledge" v-if="visible">
    <button
        type="button"
        class="ft-link ft-acknowledge__trigger"
        @click="showDialog"
    >
        {{ acknowledged ? $t('frosh-tools.acknowledge.revoke') : $t('frosh-tools.acknowledge.button') }}
    </button>
    <ft-modal
        v-if="open"
        :title="acknowledged ? $t('frosh-tools.acknowledge.revokeTitle') : $t('frosh-tools.acknowledge.title')"
        @close="close"
    >
        <p class="ft-acknowledge__warning" role="note">
            {{ acknowledged ? $t('frosh-tools.acknowledge.revokeWarning') : $t('frosh-tools.acknowledge.warning') }}
        </p>
        <p class="ft-acknowledge__check">
            <strong>{{ item.title || item.name || item.id }}</strong>
            <span v-if="item.current" class="ft-mono">{{ item.current }}</span>
            <span v-if="item.recommended" class="ft-mono">{{ item.recommended }}</span>
        </p>
        <div
            v-if="acknowledged && item.acknowledgement"
            class="ft-acknowledge__stored"
        >
            <span>{{ $t('frosh-tools.acknowledge.storedReason') }}</span>
            <p>{{ item.acknowledgement }}</p>
        </div>
        <label
            v-if="!acknowledged"
            class="ft-acknowledge__reason"
        >
            <span>{{ $t('frosh-tools.acknowledge.reason') }}</span>
            <textarea
                v-model="reason"
                rows="4"
                required
                :placeholder="$t('frosh-tools.acknowledge.reasonPlaceholder')"
            />
        </label>
        <template #footer>
            <ft-button
                variant="ghost"
                :disabled="saving"
                @click="close"
            >
                {{ $t('frosh-tools.acknowledge.cancel') }}
            </ft-button>
            <ft-button
                :disabled="saving || (!acknowledged && !reason.trim())"
                @click="confirm"
            >
                {{ acknowledged ? $t('frosh-tools.acknowledge.revokeConfirm') : $t('frosh-tools.acknowledge.save') }}
            </ft-button>
        </template>
    </ft-modal>
</div>
