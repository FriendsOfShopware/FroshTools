<template v-if="hasPermission && isException">
    <router-link
        :to="{ name: 'frosh.tools.index.index' }"
        class="frosh-tools-health-status"
        :class="{ 'is--collapsed': collapsed }"
        :aria-label="healthPlaceholder"
        v-tooltip="{
            showDelay: 300,
            message: healthPlaceholder
        }"
    >
        <mt-badge
            :variant="meteorVariant"
            size="s"
            :status-indicator="true"
        >
            {{ badgeLabel }}
        </mt-badge>
    </router-link>
</template>

<template v-else>
    <slot></slot>

    <router-link
        v-if="hasPermission && health"
        :to="{ name: 'frosh.tools.index.index' }"
        class="frosh-tools-health-status frosh-tools-health-status--ok"
        :aria-label="healthPlaceholder"
        v-tooltip="{
            showDelay: 300,
            message: healthPlaceholder
        }"
    >
        <span class="frosh-tools-health-status__dot"></span>
    </router-link>
</template>
