<div class="ft frosh-tab-data-integrity">
    <ft-page-head
        :title="$t('frosh-tools.tabs.data-integrity.title')"
        :subtitle="$t('frosh-tools.tabs.data-integrity.subtitle')"
    >
        <template #actions>
            <ft-refresh-button
                :loading="isLoading"
                @click="refresh"
            />
        </template>
    </ft-page-head>
    <ft-hero-state
        v-if="loadError"
        variant="danger"
        icon="alert"
        :title="$t('frosh-tools.loadError.title')"
        :body="loadError"
    >
        <template #actions>
            <ft-button
                icon="refresh"
                @click="refresh"
            >
                {{ $t('frosh-tools.loadError.retry') }}
            </ft-button>
        </template>
    </ft-hero-state>
    <ft-panel
        v-else
        :title="$t('frosh-tools.tabs.data-integrity.checks')"
        :count="dataIntegrityStatus ? dataIntegrityStatus.length : 0"
        flush
    >
        <ft-empty
            v-if="isLoading && !dataIntegrityStatus"
            loading
        />
        <ft-empty
            v-else-if="!dataIntegrityStatus || dataIntegrityStatus.length === 0"
            :title="$t('frosh-tools.tabs.data-integrity.noChecks')"
        />
        <div
            v-else
            class="ft-table-wrap"
        >
            <table class="ft-table">
                <thead>
                    <tr>
                        <ft-th-sort
                            sort-key="state"
                            table="dataIntegrity"
                            style="width: 110px;"
                        >{{ $t('frosh-tools.status') }}</ft-th-sort>
                        <ft-th-sort
                            sort-key="snippet"
                            table="dataIntegrity"
                        >{{ $t('frosh-tools.name') }}</ft-th-sort>
                        <ft-th-sort
                            sort-key="current"
                            table="dataIntegrity"
                        >
                            {{ $t('frosh-tools.current') }}
                        </ft-th-sort>
                        <ft-th-sort
                            sort-key="recommended"
                            table="dataIntegrity"
                        >
                            {{ $t('frosh-tools.recommended') }}
                        </ft-th-sort>
                    </tr>
                </thead>
                <tbody>
                    <tr
                        v-for="(item, idx) in sortRows(dataIntegrityStatus, 'dataIntegrity')"
                        :key="`d-${idx}`"
                    >
                        <td>
                            <ft-pill :variant="pillVariant(item.state)">{{ stateLabel(item.state) }}</ft-pill>
                        </td>
                        <td class="ft-table__name">
                            {{ item.snippet }}
                            <button
                                v-if="hasInfo(item)"
                                type="button"
                                class="ft-link ft-info-trigger"
                                @click="openInfo(item)"
                            >
                                {{ $t('frosh-tools.tabs.data-integrity.info') }}
                            </button>
                        </td>
                        <td class="ft-mono">{{ item.current }}</td>
                        <td class="ft-mono">{{ item.recommended }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </ft-panel>
    <ft-modal
        v-if="activeInfo"
        :title="activeInfo.snippet"
        @close="closeInfo"
    >
        <div class="ft-info-modal">
            <div class="ft-info-modal__status">
                <ft-pill :variant="pillVariant(activeInfo.state)">
                    {{ stateLabel(activeInfo.state) }}
                </ft-pill>
                <div
                    class="ft-info-modal__values"
                    v-if="activeInfo.current || activeInfo.recommended"
                >
                    <span
                        class="ft-info-modal__value"
                        v-if="activeInfo.current"
                    >
                        <span class="ft-info-modal__value-label">
                            {{ $t('frosh-tools.current') }}
                        </span>
                        <span class="ft-mono">{{ activeInfo.current }}</span>
                    </span>
                    <span
                        class="ft-info-modal__value"
                        v-if="activeInfo.recommended"
                    >
                        <span class="ft-info-modal__value-label">
                            {{ $t('frosh-tools.recommended') }}
                        </span>
                        <span class="ft-mono">{{ activeInfo.recommended }}</span>
                    </span>
                </div>
            </div>
            <template v-if="recommendationFor(activeInfo)">
                <section class="ft-info-modal__section">
                    <h3 class="ft-info-modal__heading">
                        {{ $t('frosh-tools.tabs.data-integrity.recommendation.what') }}
                    </h3>
                    <p class="ft-info-modal__text">
                        {{ recommendationFor(activeInfo).description }}
                    </p>
                </section>
                <section
                    class="ft-info-modal__section"
                    v-if="recommendationFor(activeInfo).solution"
                >
                    <h3 class="ft-info-modal__heading">
                        {{ $t('frosh-tools.tabs.data-integrity.recommendation.how') }}
                    </h3>
                    <p class="ft-info-modal__text">
                        {{ recommendationFor(activeInfo).solution }}
                    </p>
                </section>
            </template>
        </div>
    </ft-modal>
</div>