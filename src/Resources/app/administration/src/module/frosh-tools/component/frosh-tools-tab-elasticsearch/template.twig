<div class="ft frosh-tab-es">
    <ft-page-head :title="engineName" :subtitle="$t('frosh-tools.tabs.elasticsearch.subtitle')">
        <template v-if="!isLoading && isActive" #actions>
            <ft-refresh-button :loading="isLoading" @click="createdComponent" />
        </template>
    </ft-page-head>
    <ft-section-nav
        :items="sections"
        :active="activeSection"
        :label="$t('frosh-tools.tabs.elasticsearch.title')"
    />
    <ft-empty v-if="isLoading" loading />
    <template v-else-if="!isActive">
        <ft-hero-state
            variant="danger"
            icon="alert"
            :title="$t('frosh-tools.tabs.elasticsearch.disabledTitle', { engine: engineName })"
            :body="$t('frosh-tools.tabs.elasticsearch.disabled')"
        />
    </template>

    <template v-else>
        <div
            v-if="engineVersion || clusterHealth || nodeCount !== null"
            class="frosh-tab-es__status-bar"
        >
            <div v-if="engineVersion" class="frosh-tab-es__status-item">
                <span class="frosh-tab-es__status-label">
                    {{ $t('frosh-tools.tabs.elasticsearch.version') }}
                </span>
                <ft-pill variant="info">{{ engineVersion }}</ft-pill>
            </div>
            <div v-if="nodeCount !== null" class="frosh-tab-es__status-item">
                <span class="frosh-tab-es__status-label">
                    {{ $t('frosh-tools.tabs.elasticsearch.nodes') }}
                </span>
                <ft-pill variant="info">{{ nodeCount }}</ft-pill>
            </div>
            <div v-if="clusterHealth" class="frosh-tab-es__status-item">
                <span class="frosh-tab-es__status-label">
                    {{ $t('frosh-tools.tabs.elasticsearch.status') }}
                </span>
                <ft-pill :variant="healthVariant">{{ clusterHealth }}</ft-pill>
            </div>
        </div>
        <ft-panel
            v-if="activeSection === 'indices'"
            :title="$t('frosh-tools.tabs.elasticsearch.indices')"
            :count="visibleIndices ? visibleIndices.length : 0"
            flush
        >
            <template #actions>
                <button
                    v-tooltip="{
                        showDelay: 300,
                        message: $t('frosh-tools.tabs.elasticsearch.tooltip.unused')
                    }"
                    class="ft-btn"
                    @click="showUnusedIndices"
                >
                    <ft-pill bare variant="info" class="frosh-tab-es__action-pill">
                        {{ $t('frosh-tools.tabs.elasticsearch.badge.shopware') }}
                    </ft-pill>
                    {{ $t('frosh-tools.tabs.elasticsearch.action.showUnused') }}
                </button>
            </template>
            <ft-empty
                v-if="!indices.length"
                :title="$t('frosh-tools.tabs.elasticsearch.noIndices')"
            />
            <ft-empty
                v-else-if="!visibleIndices.length"
                icon="search"
                :title="$t('frosh-tools.search.noResults', { term: searchTerm })"
            />
            <div v-else class="ft-table-wrap">
                <table class="ft-table">
                    <thead>
                        <tr>
                            <ft-th-sort sort-key="name">{{ $t('frosh-tools.name') }}</ft-th-sort>
                            <ft-th-sort sort-key="indexSize" class="ft-table__num">
                                {{ $t('frosh-tools.size') }}
                            </ft-th-sort>
                            <ft-th-sort sort-key="docs" class="ft-table__num">
                                {{ $t('frosh-tools.docs') }}
                            </ft-th-sort>
                            <th v-if="canUpdate" class="ft-table__actions">
                                {{ $t('frosh-tools.actions') }}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in sortRows(visibleIndices)" :key="item.name">
                            <td class="ft-table__name">
                                <div class="frosh-tab-es__name">
                                    <ft-pill v-if="item.aliases.length" variant="success">
                                        {{ $t('frosh-tools.active') }}
                                    </ft-pill>
                                    <span class="ft-mono">{{ item.name }}</span>
                                </div>
                            </td>
                            <td class="ft-table__num">{{ formatSize(item.indexSize) }}</td>
                            <td class="ft-table__num">{{ Number(item.docs).toLocaleString() }}</td>
                            <td v-if="canUpdate" class="ft-table__actions">
                                <button
                                    class="ft-btn ft-btn--danger"
                                    @click="askDeleteIndex(item.name)"
                                >
                                    <ft-icon name="trash" />
                                    {{ $t('frosh-tools.delete') }}
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </ft-panel>
        <ft-panel
            v-if="activeSection === 'maintenance' && canUpdate"
            :title="$t('frosh-tools.tabs.elasticsearch.sections.maintenance')"
        >
            <p class="ft-section-intro">
                {{ $t('frosh-tools.tabs.elasticsearch.maintenanceIntro') }}
            </p>
            <div class="frosh-tab-es__maintenance">
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.reindex') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.reindex') }}</p>
                    </div>
                    <button v-if="canUpdate" class="ft-btn ft-btn--primary" @click="reindex">
                        {{ $t('frosh-tools.tabs.elasticsearch.action.reindex') }}
                    </button>
                </div>
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.switchAlias') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.switchAlias') }}</p>
                    </div>
                    <button v-if="canUpdate" class="ft-btn" @click="switchAlias">
                        {{ $t('frosh-tools.tabs.elasticsearch.action.switchAlias') }}
                    </button>
                </div>
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.cleanup') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.cleanup') }}</p>
                    </div>
                    <button v-if="canUpdate" class="ft-btn" @click="cleanup">
                        {{ $t('frosh-tools.tabs.elasticsearch.action.cleanup') }}
                    </button>
                </div>
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.cleanupOrphaned') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.cleanupOrphaned') }}</p>
                    </div>
                    <button
                        v-if="canUpdate"
                        class="ft-btn ft-btn--danger"
                        :disabled="isLoadingOrphanedPreview || isCleaningOrphaned"
                        @click="openOrphanedCleanupModal"
                    >
                        <span v-if="isLoadingOrphanedPreview" class="ft-spinner" />

                        {{ $t('frosh-tools.tabs.elasticsearch.action.cleanupOrphaned') }}
                    </button>
                </div>
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.flushAll') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.flushAll') }}</p>
                    </div>
                    <button v-if="canUpdate" class="ft-btn" @click="askFlushAll">
                        {{ $t('frosh-tools.tabs.elasticsearch.action.flushAll') }}
                    </button>
                </div>
                <div class="frosh-tab-es__maintenance-row">
                    <div>
                        <h3>{{ $t('frosh-tools.tabs.elasticsearch.action.reset') }}</h3>
                        <p>{{ $t('frosh-tools.tabs.elasticsearch.actionHelp.reset') }}</p>
                    </div>
                    <button v-if="canUpdate" class="ft-btn ft-btn--danger" @click="askReset">
                        {{ $t('frosh-tools.tabs.elasticsearch.action.reset') }}
                    </button>
                </div>
            </div>
        </ft-panel>
        <ft-panel
            v-if="canUpdate && activeSection === 'console'"
            :title="$t('frosh-tools.tabs.elasticsearch.console.title', { engine: engineName })"
        >
            <template #actions>
                <button class="ft-btn ft-btn--primary" @click="onConsoleEnter">
                    <ft-icon name="send" />
                    {{ $t('frosh-tools.tabs.elasticsearch.console.send') }}
                </button>
            </template>
            <div class="frosh-tab-es__editor">
                <sw-code-editor
                    ref="consoleEditor"
                    v-model:value="consoleInput"
                    completion-mode="text"
                    mode="twig"
                    :soft-wraps="true"
                    :set-focus="false"
                    :disabled="false"
                    :sanitize-input="false"
                    @mounted="resizeCodeEditor('consoleEditor')"
                />
            </div>
            <div class="frosh-tab-es__output-label">
                {{ $t('frosh-tools.tabs.elasticsearch.console.output') }}
            </div>
            <pre class="ft-diff frosh-tab-es__output">{{ consoleOutput }}</pre>
        </ft-panel>
    </template>
    <ft-modal
        v-if="confirmAction"
        :title="$t(`frosh-tools.tabs.elasticsearch.confirm.${confirmAction.key}.title`, { name: confirmAction.indexName })"
        variant="small"
        :close-on-backdrop="!isConfirmingAction"
        @close="cancelConfirmAction"
    >
        {{ $t(`frosh-tools.tabs.elasticsearch.confirm.${confirmAction.key}.description`, { name:
        confirmAction.indexName }) }}
        <template #footer>
            <button class="ft-btn" :disabled="isConfirmingAction" @click="cancelConfirmAction">
                {{ $t('global.default.cancel') }}
            </button>
            <button
                :class="['ft-btn', confirmAction.key === 'flushAll' ? 'ft-btn--primary' : 'ft-btn--danger']"
                :disabled="isConfirmingAction"
                @click="runConfirmedAction"
            >
                <span v-if="isConfirmingAction" class="ft-spinner" />
                <ft-icon v-else name="trash" />
                {{ $t(`frosh-tools.tabs.elasticsearch.confirm.${confirmAction.key}.confirm`) }}
            </button>
        </template>
    </ft-modal>
    <ft-modal
        v-if="showOrphanedCleanupModal"
        :title="$t('frosh-tools.tabs.elasticsearch.orphanedModal.title')"
        variant="large"
        @close="closeOrphanedCleanupModal()"
    >
        <div class="frosh-tab-es__cleanup-modal">
            <div class="frosh-tab-es__cleanup-summary">
                <ft-pill variant="warning">
                    {{ $t('frosh-tools.tabs.elasticsearch.badge.heuristic') }}
                </ft-pill>
                <span>
                    {{ $t('frosh-tools.tabs.elasticsearch.orphanedModal.summary', { count:
                    orphanedCleanupIndices.length }) }}
                </span>
            </div>
            <p class="frosh-tab-es__cleanup-text">
                {{ $t('frosh-tools.tabs.elasticsearch.orphanedModal.description') }}
            </p>
            <ul class="frosh-tab-es__index-list">
                <li
                    v-for="index in orphanedCleanupIndices"
                    :key="index"
                    class="frosh-tab-es__index-list-item ft-mono"
                >
                    {{ index }}
                </li>
            </ul>
        </div>
        <template #footer>
            <button
                class="ft-btn"
                :disabled="isCleaningOrphaned"
                @click="closeOrphanedCleanupModal()"
            >
                {{ $t('global.default.cancel') }}
            </button>
            <button
                class="ft-btn ft-btn--danger"
                :disabled="isCleaningOrphaned"
                @click="confirmCleanupOrphaned"
            >
                <span v-if="isCleaningOrphaned" class="ft-spinner" />
                <ft-icon v-else name="trash" />
                {{ $t('frosh-tools.tabs.elasticsearch.orphanedModal.delete') }}
            </button>
        </template>
    </ft-modal>
</div>
