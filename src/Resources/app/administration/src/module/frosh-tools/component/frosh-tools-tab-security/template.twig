<div class="ft frosh-tab-security">
    <ft-page-head
        :title="$t('frosh-tools.tabs.security.title')"
        :subtitle="$t('frosh-tools.tabs.security.subtitle')"
    >
        <template #actions>
            <ft-button
                variant="ghost"
                icon="download"
                :disabled="isExportingSbom || isLoading"
                :title="$t('frosh-tools.tabs.security.exportSbom')"
                @click="exportSbom"
            >
                {{ $t('frosh-tools.tabs.security.exportSbom') }}
            </ft-button>
            <ft-refresh-button
                v-if="activeTab === 'overview'"
                :loading="isLoading"
                @click="refresh"
            />
        </template>
    </ft-page-head>
    <ft-section-nav
        :items="tabs"
        :active="activeTab"
        :label="$t('frosh-tools.tabs.security.title')"
    />

    <ft-panel v-if="activeTab === 'overview'" class="frosh-tab-security__hero">
        <ft-hero-state
            v-if="error"
            variant="danger"
            icon="alert"
            :title="$t('frosh-tools.tabs.security.checkFailed')"
            :body="error"
        />
        <ft-severity-bar v-else :summary="summary" :loading="isLoading" />
    </ft-panel>
    <div
        v-if="activeTab === 'overview' && !noticeDismissed"
        class="frosh-tab-security__notice"
        role="note"
    >
        <ft-icon name="info" :size="16" />
        <span class="frosh-tab-security__notice-text">
            {{ $t('frosh-tools.tabs.security.notice') }}
        </span>
        <button
            type="button"
            class="frosh-tab-security__notice-close"
            :aria-label="$t('global.default.close')"
            @click="dismissNotice"
        >
            <ft-icon name="close" :size="14" />
        </button>
    </div>
    <div class="frosh-tab-security__body">
        <frosh-tools-security-overview
            v-if="activeTab === 'overview'"
            :findings="findings"
            :loading="isLoading"
            :error="error"
            @navigate="selectTab"
        />
        <frosh-tools-security-dependencies v-else-if="activeTab === 'dependencies'" />
        <frosh-tools-security-files v-else-if="activeTab === 'files'" />
        <frosh-tools-security-timeline v-else-if="activeTab === 'timeline'" />
    </div>
</div>
