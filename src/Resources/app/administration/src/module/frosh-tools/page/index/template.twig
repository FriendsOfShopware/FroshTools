<sw-page class="frosh-tools">
    <template v-if="searchTab" #search-bar>
        <sw-search-bar
            :key="$route.name"
            :initial-search-type="searchTab.type"
            :placeholder="$t(searchTab.placeholderKey)"
            :type-search-always-in-container="false"
            @search="onSearch"
        />
    </template>

    <template #content>
        <div class="ft ft-shell">
            <div class="ft-mobile-navigation">
                <label for="ft-tool-picker">{{ $t('frosh-tools.nav.chooseTool') }}</label>
                <select
                    id="ft-tool-picker"
                    :value="$route.name"
                    @change="navigateToTool($event.target.value)"
                >
                    <optgroup
                        v-for="group in navGroups"
                        :key="group.labelKey"
                        :label="$t(group.labelKey)"
                    >
                        <option v-for="item in group.items" :key="item.route" :value="item.route">
                            {{ $t(item.labelKey) }}
                        </option>
                    </optgroup>
                </select>
            </div>
            <nav ref="navigation" class="ft-sidebar" :aria-label="$t('frosh-tools.title')">
                <div class="ft-sidebar__brand">
                    <div class="ft-sidebar__brand-mark">
                        <ft-icon name="tools" :size="22" />
                    </div>
                    <div>
                        <div class="ft-sidebar__brand-title">{{ $t('frosh-tools.title') }}</div>
                        <div class="ft-sidebar__brand-sub">
                            {{ $t('frosh-tools.sidebar.developerConsole') }}
                        </div>
                    </div>
                </div>
                <template v-for="group in navGroups" :key="group.labelKey">
                    <div v-if="group.items.length" class="ft-sidebar__group">
                        <div class="ft-sidebar__group-label">{{ $t(group.labelKey) }}</div>
                        <router-link
                            v-for="item in group.items"
                            :key="item.route"
                            :to="{ name: item.route }"
                            class="ft-sidebar__item"
                            active-class="is-active"
                        >
                            <ft-icon :name="item.icon" :size="18" />
                            <span>{{ $t(item.labelKey) }}</span>
                        </router-link>
                    </div>
                </template>
            </nav>
            <div class="ft-main">
                <router-view />
            </div>
        </div>
    </template>
</sw-page>
